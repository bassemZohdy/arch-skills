graph TB
    subgraph Cloud["Cloud Provider"]
        subgraph Region["Region"]
            subgraph AZ1["Availability Zone 1"]
                LB1[Load Balancer]
                subgraph Cluster1["Cluster"]
                    App1[App Instance 1]
                    App2[App Instance 2]
                end
                DB1[(Primary DB)]
            end
            subgraph AZ2["Availability Zone 2"]
                LB2[Load Balancer]
                subgraph Cluster2["Cluster"]
                    App3[App Instance 3]
                    App4[App Instance 4]
                end
                DB2[(Replica DB)]
            end
        end
        Cache[(Cache)]
        Queue[Message Queue]
    end

    User[User] --> LB1
    User --> LB2
    LB1 --> Cluster1
    LB2 --> Cluster2
    App1 --> DB1
    App2 --> DB1
    App3 --> DB2
    App4 --> DB2
    DB1 -->|Replication| DB2
    App1 --> Cache
    App3 --> Cache
    App1 --> Queue
    App4 --> Queue

C4Container
    title Container Diagram for [System Name]

    Person(user, "User Type", "Description")

    System_Boundary(system, "System Name") {
        Container(app, "Application Name", "Technology", "Responsibility")
        Container(api, "API Layer", "Technology", "Responsibility")
        ContainerDb(db, "Database", "Technology", "Responsibility")
        ContainerQueue(queue, "Message Queue", "Technology", "Responsibility")
    }

    System_Ext(ext, "External System", "Description")

    Rel(user, app, "Uses", "HTTP")
    Rel(app, api, "Calls", "REST/gRPC")
    Rel(api, db, "Reads/Writes", "SQL")
    Rel(api, queue, "Publishes", "AMQP")
    Rel(api, ext, "Integrates", "API")
